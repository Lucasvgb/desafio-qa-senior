    {
      "name": "TC05 - Verificar_Webhook_HMAC",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const secret = \"webhook-secret-2024\";",
              "const rawBody = pm.request.body.raw;",
              "",
              "// Calcula o HMAC-SHA256",
              "const hmac = CryptoJS.HmacSHA256(rawBody, secret).toString(CryptoJS.enc.Hex);",
              "",
              "",
              "//Adiciona ou atualiza o header ",
              "pm.request.headers.upsert({",
              "    key: \"X-Signature-256\",",
              "    value: `sha256=${hmac}`",
              "});",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
